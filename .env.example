# ── Mode ──────────────────────────────────────────────────────────────────────
# "manual"  → web form only. Only needs OPENAI_API_KEY, OPENAI_MODEL, ACCESS_PASSWORD.
# "webhook" → full Strava automation. All STRAVA_* vars required.
MODE=manual

# ── Manual mode ───────────────────────────────────────────────────────────────
# Password for the web UI. Required when MODE=manual.
# Make it long and random — it's the only thing protecting the page.
ACCESS_PASSWORD=change_me_to_a_long_random_string

# ── OpenAI (required in both modes) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
# gpt-4o-mini is cheap (~$0.01/month at a few runs/week). Change if desired.
OPENAI_MODEL=gpt-4o-mini

# ── Strava OAuth (required only when MODE=webhook) ─────────────────────────────
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Obtained from setup_oauth.py — leave blank until you run it
STRAVA_REFRESH_TOKEN=your_refresh_token_here
ATHLETE_ID=your_athlete_id_here

# Any random secret string — set it before running setup_oauth.py
STRAVA_VERIFY_TOKEN=change_me_to_a_random_secret

# Strava API base URL.
# UPDATE to https://api-v3.strava.com/api/v3 after January 4, 2027
STRAVA_BASE_URL=https://www.strava.com/api/v3

# ── App behaviour ─────────────────────────────────────────────────────────────
# Set to true to log the generated title without writing it to Strava.
# Only matters in webhook mode.
DRY_RUN=true

# SQLite database path. Override in Docker to a volume path (webhook mode only).
DB_PATH=run_titler.db
